# =========================================================================
# Shopify CRO Opportunity Engine - Environment Configuration Template
# =========================================================================

# Google Gemini API key (Obtained from Google AI Studio)
# Required for running storefront optimization models.
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI
# Required for persisting storefront audit histories.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# Application Base URL (Required for page canonical headers and routing parameters)
APP_URL=http://localhost:3000

# Environment Mode (development, production)
NODE_ENV=development

# API Versioning configuration
API_VERSION=v1

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
